{
  "info": {
    "_postman_id": "9f2d7a1c-shemms-phase2-collection",
    "name": "SHEMMS Backend - Phase 2",
    "description": "Full Phase 2 REST API coverage for the Smart Home Energy Monitoring & Management System backend. Use the SHEMMS Local environment. Login auto-stores the JWT into the `jwt_token` environment variable; appliance/schedule/alert IDs are also captured into env vars by the test scripts to chain requests easily.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{jwt_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "appliance_id", "value": "" },
    { "key": "schedule_id", "value": "" },
    { "key": "alert_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@shemms.local\",\n  \"password\": \"pw123456\",\n  \"tariff_rate\": 1.5\n}"
            },
            "description": "Create a new user account. Returns a JWT and the user record. Re-running with the same email returns 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.environment.set('jwt_token', body.token);",
                  "  pm.test('Registered with token', function () {",
                  "    pm.expect(body).to.have.property('token');",
                  "    pm.expect(body.user).to.have.property('id');",
                  "  });",
                  "} else if (pm.response.code === 409) {",
                  "  pm.test('Email already exists - run Login instead', function () {",
                  "    pm.expect(pm.response.code).to.equal(409);",
                  "  });",
                  "} else {",
                  "  pm.test('Unexpected status', function () {",
                  "    pm.expect.fail('Status was ' + pm.response.code + ': ' + pm.response.text());",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@shemms.local\",\n  \"password\": \"pw123456\"\n}"
            },
            "description": "Authenticate and receive a JWT. The test script auto-saves the token to the `jwt_token` environment variable so every subsequent request authorizes via Bearer {{jwt_token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response contains JWT token', function () {",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (body && body.token) {",
                  "  pm.environment.set('jwt_token', body.token);",
                  "  console.log('Saved jwt_token to environment');",
                  "}",
                  "",
                  "if (body && body.user && body.user.id) {",
                  "  pm.environment.set('user_id', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Appliances",
      "item": [
        {
          "name": "List Appliances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/appliances",
              "host": ["{{base_url}}"],
              "path": ["api", "appliances"]
            },
            "description": "List all appliances belonging to the authenticated user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns appliances array', function () { pm.expect(body.appliances).to.be.an('array'); });",
                  "if (body.appliances && body.appliances.length > 0) {",
                  "  pm.environment.set('appliance_id', body.appliances[0].id);",
                  "  console.log('Saved appliance_id from first appliance');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },

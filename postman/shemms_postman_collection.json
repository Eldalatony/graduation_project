              "raw": "{\n  \"name\": \"Kitchen Appliance\",\n  \"node_key\": \"kitchen\",\n  \"gateway_id\": \"ESP32_Main_Hub\",\n  \"is_active\": true\n}"
            },
            "description": "Register a new appliance. node_key must match a key the simulator publishes (kitchen, laundry, climate)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",

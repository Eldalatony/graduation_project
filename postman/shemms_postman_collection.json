        {
          "name": "Update Appliance",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/appliances/{{appliance_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "appliances", "{{appliance_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kitchen (Updated)\"\n}"
            },
            "description": "Update fields of an existing appliance. Any subset of name, node_key, gateway_id, is_active is allowed."
          },
          "response": []
        },
        {
          "name": "Control Appliance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/appliances/{{appliance_id}}/control",
              "host": ["{{base_url}}"],
              "path": ["api", "appliances", "{{appliance_id}}", "control"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"off\"\n}"
            },
            "description": "Publish an MQTT control command to home/gateway/{gateway_id}/control/{node_key}. Valid commands: on, off, turn_on, turn_off."
          },
          "response": []
        },
        {
          "name": "Get Live Readings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/appliances/{{appliance_id}}/readings?minutes=5",
              "host": ["{{base_url}}"],
              "path": ["api", "appliances", "{{appliance_id}}", "readings"],
              "query": [
                { "key": "minutes", "value": "5" }
              ]
            },
            "description": "Fetch decrypted live readings (power_W, current_A, voltage_V, energy_kWh, cost_EGP) from InfluxDB for the last N minutes (max 60)."
          },
          "response": []
        },
        {
          "name": "Delete Appliance",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/appliances/{{appliance_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "appliances", "{{appliance_id}}"]
            },
            "description": "Remove an appliance. Cascade-deletes its schedules and alerts."
          },
          "response": []
        }
      ]

                  "if (body.appliance && body.appliance.id) {",
                  "  pm.environment.set('appliance_id', body.appliance.id);",
                  "  console.log('Saved appliance_id: ' + body.appliance.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create Appliance - Laundry",
          "request": {
            "method": "POST",
            "header": [

# Mongo URI inside Docker — `mongodb` is the docker-compose service name
MONGO_URI=mongodb://mongodb:27017/shemms
MONGO_DB=shemms

# Flask
FLASK_PORT=5000

# Background inference
INFER_ENABLED=true
INFER_INTERVAL_MIN=30

# Aggregation interval — 60 for backend ETL (hourly), 30 for synthetic seed
INTERVAL_MINUTES=60

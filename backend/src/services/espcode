// ===== WiFi Helper =====
void connectWiFi() {
  Serial.println("----------------------------------");
  Serial.println("[CHECKPOINT] Starting WiFi...");
  Serial.print("[CHECKPOINT] SSID: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    attempts++;
    if (attempts > 40) {
      Serial.println("\n[ERROR] WiFi FAILED — wrong SSID or password");
      Serial.println("[STOPPED] Fix WiFi credentials and reboot");
      while (true) delay(1000);
    }
  }
  Serial.println();
  Serial.println("[CHECKPOINT] WiFi connected!");
  Serial.print("[CHECKPOINT] IP Address: ");
  Serial.println(WiFi.localIP());
  Serial.print("[CHECKPOINT] Signal strength (RSSI): ");
  Serial.print(WiFi.RSSI());
  Serial.println(" dBm");
  Serial.println("----------------------------------");
}

// ===== NTP Helper (UTC for ISO-8601 timestamps) =====
void syncTime() {
  Serial.println("[CHECKPOINT] Syncing time via NTP...");
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  time_t now = 0;
  int attempts = 0;
  while ((now = time(nullptr)) < 1700000000 && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  Serial.println();
  if (now < 1700000000) {
    Serial.println("[WARN] NTP sync failed — timestamps will be omitted");
  } else {
    Serial.print("[CHECKPOINT] Time synced: ");
    Serial.println((long)now);
  }
}

// Fills `out` with an ISO-8601 UTC timestamp, e.g. "2026-05-01T12:34:56Z".
// Returns true on success, false if time is not yet synced.
bool isoTimestamp(char* out, size_t len) {
  time_t now = time(nullptr);
  if (now < 1700000000) return false;
  struct tm tm_utc;
  gmtime_r(&now, &tm_utc);
  strftime(out, len, "%Y-%m-%dT%H:%M:%SZ", &tm_utc);
  return true;
}

// ===== MQTT Helper =====
void connectMQTT() {
  Serial.println("[CHECKPOINT] Setting insecure mode...");
  net.setInsecure();
  Serial.println("[CHECKPOINT] Insecure mode set");

  mqtt.setServer(MQTT_BROKER, MQTT_PORT);
  mqtt.setBufferSize(1024);
  mqtt.setKeepAlive(60);

  Serial.print("[CHECKPOINT] Connecting to broker: ");
  Serial.println(MQTT_BROKER);

  int attempts = 0;
  while (!mqtt.connected()) {
    attempts++;
    Serial.printf("[CHECKPOINT] Attempt #%d...\n", attempts);

    if (mqtt.connect(MQTT_CLIENT_ID, MQTT_USERNAME, MQTT_PASSWORD)) {
      Serial.println("[CHECKPOINT] MQTT connected!");
      Serial.print("[CHECKPOINT] Publishing to topic: ");
      Serial.println(MQTT_TOPIC);
      Serial.println("----------------------------------");
    } else {
      int rc = mqtt.state();
      Serial.print("[ERROR] MQTT failed, rc=");
      Serial.print(rc);
      switch (rc) {
        case -4: Serial.println(" (TIMEOUT — broker unreachable)");      break;
        case -3: Serial.println(" (CONNECTION LOST)");                   break;
        case -2: Serial.println(" (CONNECT FAILED — TLS error?)");       break;
        case -1: Serial.println(" (DISCONNECTED)");                      break;
        case  1: Serial.println(" (BAD PROTOCOL)");                      break;
        case  2: Serial.println(" (BAD CLIENT ID)");                     break;
        case  3: Serial.println(" (BROKER UNAVAILABLE)");                break;
        case  4: Serial.println(" (BAD CREDENTIALS — wrong user/pass)"); break;
        case  5: Serial.println(" (UNAUTHORIZED)");                      break;
        default: Serial.println(" (UNKNOWN ERROR)");                     break;
      }
      if (attempts >= 5) {
        Serial.println("[STOPPED] MQTT failed 5 times — fix credentials and reboot");
        while (true) delay(1000);
      }
      Serial.println("[CHECKPOINT] Retrying in 3s...");
      delay(3000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("==================================");
  Serial.println("[CHECKPOINT] Serial started");

  // ADC setup
  analogReadResolution(12);
  analogSetPinAttenuation(CURRENT_PIN, ADC_11db);
  analogSetPinAttenuation(VOLTAGE_PIN, ADC_11db);
  Serial.println("[CHECKPOINT] ADC configured");

  // I2C + LCD
  Serial.println("[CHECKPOINT] Starting I2C on SDA=21 SCL=22...");
  Wire.begin(21, 22);
  lcd.init();
  lcd.backlight();
  Serial.println("[CHECKPOINT] LCD initialized");

  // Calibration
  lcd.setCursor(0, 0);
  lcd.print("Calibrating...");
  Serial.println("[CHECKPOINT] Calibrating current offset (1000 samples)...");
  long currentSum = 0;
  for (int i = 0; i < 1000; i++) {
    currentSum += analogRead(CURRENT_PIN);
    delay(2);
  }
  currentOffset = currentSum / 1000.0;
  Serial.print("[CHECKPOINT] Calibration done — current offset=");
  Serial.println(currentOffset);

  lcd.clear();
  lcd.print("Ready");
  Serial.println("[CHECKPOINT] LCD printed 'Ready'");
  delay(1000);
  lcd.clear();

  Serial.println("==================================");

  connectWiFi();
  syncTime();
  connectMQTT();
}

float readCurrent() {
  const int samples = 1500;
  float sum = 0;
  for (int i = 0; i < samples; i++) {
    float centered = analogRead(CURRENT_PIN) - currentOffset;
    float v = centered * (3.3 / 4095.0);
    sum += v * v;
    delayMicroseconds(200);
  }
  float current = sqrt(sum / samples) * currentCalibration;
  if (current < 0.005) {
    current = 0;
  }
  return current;
}

float readVoltage() {
  int maxVal = 0;
  int minVal = 4095;
  for (int i = 0; i < 1000; i++) {
    int val = analogRead(VOLTAGE_PIN);
    if (val > maxVal) maxVal = val;
    if (val < minVal) minVal = val;
    delayMicroseconds(200);
  }
  float peakToPeak = maxVal - minVal;
  float voltage = (peakToPeak * 3.3) / 4095.0;
  float vrms = (voltage / 2.0) * 0.707;
  return vrms * calibrationFactor;
}

void loop() {
  // MQTT keep-alive
  if (!mqtt.connected()) {
    Serial.println("[CHECKPOINT] MQTT disconnected — reconnecting...");
    connectMQTT();
  }
  mqtt.loop();

  // Read sensors
  float voltage = readVoltage();
  float current = readCurrent();

  if (voltage < 20) {
    voltage = 0;
  }
  smoothVoltage = (smoothVoltage * 0.70) + (voltage * 0.30);
  if (smoothVoltage < 20) {
    smoothVoltage = 0;
  }

  float power = smoothVoltage * current;
  float projected = a * smoothVoltage + b;
  const char* nodeStatus = (power > 0.5) ? "active" : "idle";

  // Build envelope payload matching the backend parser
  // (gateway_id + nodes.<NODE_KEY>.wattage; backend derives V/I from wattage).
  char ts[32];
  bool haveTs = isoTimestamp(ts, sizeof(ts));

  char payload[512];
  if (haveTs) {
    snprintf(payload, sizeof(payload),
             "{\"gateway_id\":\"%s\",\"status\":\"ONLINE\",\"timestamp\":\"%s\","
             "\"nodes\":{\"%s\":{\"wattage\":%.1f,\"status\":\"%s\"}}}",
             GATEWAY_ID, ts, NODE_KEY, power, nodeStatus);
  } else {
    snprintf(payload, sizeof(payload),
             "{\"gateway_id\":\"%s\",\"status\":\"ONLINE\","
             "\"nodes\":{\"%s\":{\"wattage\":%.1f,\"status\":\"%s\"}}}",
             GATEWAY_ID, NODE_KEY, power, nodeStatus);
  }

  bool published = mqtt.publish(MQTT_TOPIC, payload);

  // Serial debug
  Serial.print("RAW V=");        Serial.print(voltage, 1);
  Serial.print(" | Smooth V=");  Serial.print(smoothVoltage, 1);
  Serial.print(" | I=");         Serial.print(current, 3);
  Serial.print(" | P=");         Serial.print(power, 1);
  Serial.print(" | Payload: ");  Serial.print(payload);
  Serial.print(" | Published: "); Serial.println(published ? "OK" : "FAILED");

  // LCD
  lcd.setCursor(0, 0);
  lcd.print("V:");
  lcd.print(smoothVoltage, 0);
  lcd.print(" I:");
  lcd.print(current, 2);
  lcd.print("   ");

  lcd.setCursor(0, 1);
  lcd.print("P:");
  lcd.print(power, 1);
  lcd.print(" S:");
  lcd.print(projected, 0);
  lcd.print("   ");

  delay(500);
}
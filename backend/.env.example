# Backend service environment template.
# Copy to backend/.env and fill in the SECRET values (marked CHANGE_ME).
# The non-secret defaults below already match docker-compose.yml.

PORT=3001
NODE_ENV=development

# Auth — generate a random secret, e.g. `openssl rand -hex 48`
JWT_SECRET=CHANGE_ME_random_secret
JWT_EXPIRES_IN=7d

# PostgreSQL — these match the postgres service in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shemms
POSTGRES_USER=shemms_user
POSTGRES_PASSWORD=shemms_pass_2024

# InfluxDB — create a token in the Influx UI (http://localhost:8086) on first run
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=CHANGE_ME_influx_token
INFLUXDB_ORG=smart_home
INFLUXDB_BUCKET=energy_data

# MongoDB
MONGO_URI=mongodb://mongodb:27017/shemms

# MQTT (HiveMQ Cloud) — use your own cluster + credentials
MQTT_BROKER_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
MQTT_CLIENT_ID=backend_server
MQTT_USERNAME=CHANGE_ME_mqtt_user
MQTT_PASSWORD=CHANGE_ME_mqtt_password

# Internal service URL (Docker network)
ANALYTICS_SERVICE_URL=http://analytics:5000

# Metering defaults
DEFAULT_VOLTAGE=220
DEFAULT_TARIFF_RATE=1.5
DEFAULT_GATEWAY_ID=ESP32_Main_Hub
SAMPLE_INTERVAL_S=1

# Homomorphic encryption
HE_SECRET=CHANGE_ME_32_byte_hex
HE_CONTEXT_PATH=/run/secrets/tenseal_context

# Real-time alert thresholds
ALERT_HIGH_USAGE_W=1500
ALERT_LEFT_ON_SECONDS=1800
ALERT_OFFLINE_SECONDS=60
ALERT_COOLDOWN_MS=300000

# Hourly ETL (InfluxDB -> MongoDB)
ETL_CRON=5 * * * *
ETL_LOOKBACK_MIN=65

# Password-reset email (optional). Leave SMTP_USER/SMTP_PASS blank to print the
# reset code to the server console instead of sending a real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shemms
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=smart_home
INFLUXDB_BUCKET=energy_data
MONGO_URI=mongodb://mongodb:27017/shemms
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=backend_server
ANALYTICS_SERVICE_URL=http://analytics:5000
DEFAULT_VOLTAGE=220
DEFAULT_TARIFF_RATE=1.5
DEFAULT_GATEWAY_ID=ESP32_Main_Hub
SAMPLE_INTERVAL_S=1
HE_SECRET=replace_with_random_32_byte_hex
ALERT_HIGH_USAGE_W=1500
ALERT_LEFT_ON_SECONDS=1800
ALERT_OFFLINE_SECONDS=60
ALERT_COOLDOWN_MS=300000
ETL_CRON=5 * * * *
ETL_LOOKBACK_MIN=65
